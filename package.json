  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check": "tsc --noEmit && node scripts/verify-metro-config.cjs",
    "test": "jest --runInBand",
    "sync:presentation": "node scripts/sync-presentation.mjs",
    "sync:core": "node scripts/sync-web-core.mjs && node scripts/adapt-native-core.mjs",
    "verify:sign-in": "node scripts/verify-mobile-sign-in-config.mjs",
    "build:android": "npm run verify:sign-in && expo export --platform android --output-dir dist/android --max-workers 2",
    "build:ios": "npm run verify:sign-in && expo export --platform ios --output-dir dist/ios --max-workers 2",
    "build": "npm run build:android && npm run build:ios",
    "verify:release": "node scripts/verify-native-release.mjs"
  },
  "private": true
