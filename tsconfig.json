{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "skipLibCheck": true
  },
  "include": ["App.tsx", "index.ts", "src/app/**/*.ts", "src/app/**/*.tsx", "src/platform/**/*.ts", "src/platform/**/*.tsx"],
  "exclude": ["node_modules", "src/core/web"]
}
