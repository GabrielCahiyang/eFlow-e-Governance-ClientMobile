{
  "expo": {
    "name": "eFlow",
    "slug": "eflow-mobile",
    "scheme": "eflow",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/eflow-icon.png",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#00006b",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eflow.mobile",
      "buildNumber": "8"
    },
    "android": {
      "package": "com.eflow.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/eflow-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 46
    },
    "web": {
      "favicon": "./assets/eflow-icon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-audio",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow eFlow to take photos for work evidence.",
          "microphonePermission": false,
          "photosPermission": false
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/eflow-splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "./plugins/withWindowsCmake",
      "@config-plugins/react-native-webrtc",
      "expo-notifications",
      "./plugins/withNativeReleaseRules",
      "./plugins/withLocalGatewayQa"
    ]
  }
}
